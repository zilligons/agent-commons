{
  "name": "@uuaid/agent-commons",
  "version": "1.0.1",
  "description": "Agent Commons: agent-only local and federated communications, UUAID trust gates, Pillar encrypted transport, and scoped protocol evolution.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/zilligons/agent-commons.git", "directory": "packages/agent-commons" },
  "homepage": "https://github.com/zilligons/agent-commons#readme",
  "bugs": { "url": "https://github.com/zilligons/agent-commons/issues" },
  "engines": { "node": ">=22.13.0" },
  "bin": { "agent-commons": "bin/agent-commons.mjs" },
  "exports": {
    ".": { "types": "./src/index.d.ts", "import": "./src/index.mjs" },
    "./profiles": "./src/profiles.mjs",
    "./trust": "./src/trust.mjs",
    "./carrier": "./src/carrier.mjs",
    "./pillar": "./src/pillar.mjs",
    "./continuity": { "types": "./src/continuity.d.mts", "import": "./src/continuity.mjs" },
    "./collaboration": "./src/collaboration.mjs",
    "./governance": "./src/governance.mjs",
    "./cohort": "./src/cohort.mjs",
    "./transport": { "types": "./src/transport.d.mts", "import": "./src/transport.mjs" },
    "./channels": { "types": "./src/channels.d.mts", "import": "./src/channels.mjs" },
    "./governance-scope": { "types": "./src/governance-scope.d.mts", "import": "./src/governance-scope.mjs" },
    "./relay/client": "./src/relay/client.mjs",
    "./relay/seed": "./src/relay/seed.mjs",
    "./relay/auth": "./src/relay/auth.mjs",
    "./square": { "types": "./src/square/index.d.mts", "import": "./src/square/index.mjs" },
    "./key-continuity": { "types": "./src/key-continuity.d.mts", "import": "./src/key-continuity.mjs" },
    "./keychain-import": { "types": "./src/keychain-import.d.mts", "import": "./src/keychain-import.mjs" },
    "./spaces": { "types": "./src/spaces/driver.d.mts", "import": "./src/spaces/driver.mjs" },
    "./conformance": { "types": "./src/conformance.d.mts", "import": "./src/conformance.mjs" },
    "./package.json": "./package.json"

  },
  "files": ["bin", "src", "profiles", "examples", "README.md", "LICENSE", "NOTICE", "PROVENANCE.json", "CONFORMANCE.md"],
  "scripts": { "test": "node --test test/*.test.mjs", "test:expected-red": "node --test test/governance-expected-red.expected-red.mjs", "prepublishOnly": "npm test" },
  "dependencies": { "@noble/curves": "2.3.0", "@uuaid/sdk": "0.3.0" },
  "publishConfig": { "access": "public", "tag": "latest", "provenance": true },
  "keywords": ["agents", "agent-commons", "uuaid", "iaaso", "pillar", "agentnet", "zilligon"]
}
