#!/usr/bin/env python3
"""Offline child transport for the cohort bridge (PATH fixture for CohortConsole.call).

No provider imports, credentials, prompts or key output. Uses the real describe_error
classifier; live model access is not exercised here. See cohort.offline.test.ts.
"""
import importlib.util
import json
import os
from pathlib import Path
import sys
import time

root = Path(__file__).resolve().parents[3]
if sys.argv[1:] != ["server/cohort_bridge.py"]:
    raise RuntimeError("Offline fixture refuses an unexpected bridge command")
spec = importlib.util.spec_from_file_location("offline_cohort_bridge", root / "server/cohort_bridge.py")
bridge = importlib.util.module_from_spec(spec)
spec.loader.exec_module(bridge)
request = json.load(sys.stdin)
fixture = json.loads((root / "server/fixtures/offline-model-results.json").read_text())
row = next(item for item in fixture["results"] if item["model"] == request["model"])
scenario = os.environ.get("OFFLINE_FIXTURE_SCENARIO", "mixed")
with open(os.environ["OFFLINE_FIXTURE_TRACE"], "a") as trace:
    trace.write(json.dumps({"model": row["model"], "scenario": scenario}) + "\n")

class FakeCode:
    def __init__(self, name):
        self.name = name

class FixtureRpcError(Exception):
    def __init__(self, status):
        self.status = status
    def code(self):
        return FakeCode(self.status)
    def details(self):
        return "fixture-only-private-detail https://fixture.invalid/header"

if scenario == "pending":
    time.sleep(30)
elif scenario == "invalid-json":
    print("not-json")
elif scenario == "empty":
    print(json.dumps(bridge.describe_error(RuntimeError("Empty provider response"))))
elif scenario == "unknown":
    print(json.dumps(bridge.describe_error(FixtureRpcError("UNKNOWN"))))
elif scenario == "timeout":
    print(json.dumps(bridge.describe_error(FixtureRpcError("DEADLINE_EXCEEDED"))))
elif scenario == "mixed":
    if row["status"] == "OK":
        print(json.dumps({"text": "OK"}))
    else:
        print(json.dumps(bridge.describe_error(FixtureRpcError(row["status"]))))
else:
    raise RuntimeError("Unknown offline fixture scenario")
